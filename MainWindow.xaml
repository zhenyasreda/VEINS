<ui:FluentWindow x:Class="VpnProvisioner.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="VpnProvisioner"
                Height="820" Width="840"
                MinHeight="640" MinWidth="680"
                WindowStartupLocation="CenterScreen"
                ExtendsContentIntoTitleBar="True"
                WindowBackdropType="Mica"
                WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VpnProvisioner"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,8,24,24">
            <StackPanel MaxWidth="740">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,12">
                    <ui:Button x:Name="LangButton"
                               Icon="{ui:SymbolIcon Globe24}"
                               Appearance="Transparent"
                               ToolTipService.Placement="Bottom"
                               ToolTipService.ShowDuration="5000"
                               ToolTip="Сменить язык"
                               Margin="0,0,4,0"
                               Click="OnLangToggleClick"/>
                    <ui:Button x:Name="ThemeButton"
                               Icon="{ui:SymbolIcon DarkTheme24}"
                               Appearance="Transparent"
                               ToolTipService.Placement="Bottom"
                               ToolTipService.ShowDuration="5000"
                               ToolTip="Сменить тему"
                               Click="OnThemeToggleClick"/>
                </StackPanel>

                <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
                    <StackPanel>
                        <TextBlock x:Name="LblServerConnection"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16">
                            <Run x:Name="IconServer" Text="&#xE71B;" FontFamily="Segoe Fluent Icons"/>
                            <Run x:Name="TxtServerConnection" Text="  Подключение к серверу"/>
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ui:TextBox Grid.Row="0" Grid.Column="0"
                                        x:Name="HostBox"
                                        PlaceholderText="IP-адрес или домен сервера"
                                        Icon="{ui:SymbolIcon Server24}"
                                        Margin="{StaticResource FieldMargin}"/>
                            <ui:TextBox Grid.Row="0" Grid.Column="2"
                                        x:Name="SshPortBox"
                                        Text="22"
                                        PlaceholderText="22"
                                        Icon="{ui:SymbolIcon NumberSymbol24}"
                                        Margin="{StaticResource FieldMargin}"/>

                            <ui:TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        x:Name="UserBox"
                                        Text="root"
                                        PlaceholderText="Пользователь SSH"
                                        Icon="{ui:SymbolIcon Person24}"
                                        Margin="{StaticResource FieldMargin}"/>

                            <ui:PasswordBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                            x:Name="PasswordBox"
                                            PlaceholderText="Пароль сервера"
                                            Icon="{ui:SymbolIcon Key24}"
                                            RevealButtonEnabled="True"
                                            Margin="{StaticResource FieldMargin}"/>

                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="{StaticResource FieldMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            x:Name="KeyBox"
                                            PlaceholderText="Путь к приватному SSH-ключу (опционально)"
                                            Icon="{ui:SymbolIcon Key24}"/>
                                <ui:Button Grid.Column="2"
                                           x:Name="BrowseButton"
                                           Content="Обзор"
                                           Icon="{ui:SymbolIcon Folder24}"
                                           Appearance="Secondary"
                                           VerticalAlignment="Stretch"
                                           Click="OnBrowseClick"/>
                            </Grid>
                        </Grid>

                        <ui:PasswordBox x:Name="KeyPassBox"
                                        PlaceholderText="Парольная фраза ключа (опционально)"
                                        Icon="{ui:SymbolIcon LockClosed24}"
                                        RevealButtonEnabled="True"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16">
                            <Run Text="&#xE7F4;" FontFamily="Segoe Fluent Icons"/>
                            <Run x:Name="TxtProtocolOptions" Text="  Протокол и параметры"/>
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource FieldMargin}">
                                <TextBlock x:Name="LblProtocol" Text="Протокол" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ProtocolCombo"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="32"
                                          SelectionChanged="OnProtocolChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="{StaticResource FieldMargin}">
                                <TextBlock x:Name="LblSni" Text="SNI (только VLESS/Reality)" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="SniBox"
                                            Text="www.google.com"
                                            PlaceholderText="www.google.com"
                                            Icon="{ui:SymbolIcon Globe24}"/>
                            </StackPanel>

                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      x:Name="ForceCheck"
                                      Content="Пересоздать, если уже установлен"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Button x:Name="InstallButton"
                           Content="Установить"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           FontSize="14"
                           Padding="16,10"
                           Margin="0,0,0,20"
                           Click="OnInstallClick"/>

                <ui:Card Margin="{StaticResource SectionMargin}" Padding="{StaticResource CardPadding}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12">
                            <Run Text="&#xE756;" FontFamily="Segoe Fluent Icons"/>
                            <Run x:Name="TxtProgress" Text="  Ход работы"/>
                        </TextBlock>
                        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource StrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                MinHeight="200"
                                MaxHeight="320">
                            <TextBox x:Name="LogBox"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="12.5"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <ui:Card x:Name="ResultCard" Padding="{StaticResource CardPadding}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12">
                            <Run Text="&#xE735;" FontFamily="Segoe Fluent Icons"/>
                            <Run x:Name="TxtResultLink" Text="  Готовая ссылка"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        x:Name="LinkBox"
                                        IsReadOnly="True"
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="12"
                                        VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="2"
                                       x:Name="CopyButton"
                                       Content="Копировать"
                                       Icon="{ui:SymbolIcon Copy24}"
                                       Appearance="Secondary"
                                       IsEnabled="False"
                                       Click="OnCopyClick"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
